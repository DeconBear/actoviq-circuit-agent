{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://actoviq.local/schemas/pdk-device-catalog.schema.json",
  "title": "Actoviq PDK Device Catalog",
  "type": "object",
  "required": ["schema", "pdk_ref", "devices"],
  "properties": {
    "schema": { "const": "actoviq.pdk-device-catalog.v1" },
    "pdk_ref": { "type": "string", "minLength": 1 },
    "devices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["device_id", "pins", "spice", "views"],
        "properties": {
          "device_id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string" },
          "pins": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "spice": {
            "type": "object",
            "properties": {
              "primitive": { "type": "string" },
              "model": { "type": "string" },
              "pin_order": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "format": {
                "type": "string",
                "description": "Safe placeholder template, e.g. '{name} {D} {G} {S} {B} {model} w={w} l={l}'"
              }
            },
            "additionalProperties": true
          },
          "parameters": { "type": "object" },
          "views": { "type": "object" },
          "netlist_formats": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                { "type": "string" },
                {
                  "type": "object",
                  "properties": {
                    "model": { "type": "string" },
                    "format": { "type": "string" },
                    "pin_order": {
                      "type": "array",
                      "items": { "type": "string", "minLength": 1 }
                    }
                  },
                  "additionalProperties": true
                }
              ]
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
