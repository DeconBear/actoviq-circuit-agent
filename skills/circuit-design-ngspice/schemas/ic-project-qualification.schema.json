{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://actoviq.local/schemas/ic-project-qualification.schema.json",
  "title": "Actoviq IC Project Qualification",
  "type": "object",
  "required": [
    "schema",
    "qualified_at",
    "mode",
    "qualification",
    "passed",
    "environment",
    "project",
    "pdk",
    "tools",
    "gates",
    "artifacts",
    "commercial_boundary"
  ],
  "properties": {
    "schema": { "const": "actoviq.ic-project-qualification.v1" },
    "qualified_at": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["native", "fixture"] },
    "qualification": {
      "enum": ["native_verified", "fixture_verified", "blocked", "failed"]
    },
    "passed": { "type": "boolean" },
    "environment": {
      "type": "object",
      "required": [
        "platform",
        "release",
        "distribution",
        "distribution_version",
        "native_linux",
        "wsl",
        "eligible"
      ],
      "properties": {
        "platform": { "type": "string", "minLength": 1 },
        "release": { "type": "string" },
        "distribution": { "type": "string" },
        "distribution_version": { "type": "string" },
        "native_linux": { "type": "boolean" },
        "wsl": { "type": "boolean" },
        "eligible": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "required": [
        "project_id",
        "project_kind",
        "revision",
        "project_hash",
        "document_hash",
        "connectivity_hash",
        "module_hashes",
        "module_count",
        "module_instance_count",
        "pdk_device_count"
      ],
      "properties": {
        "project_id": { "type": "string", "minLength": 1 },
        "project_kind": { "enum": ["analog_ic", "mixed_signal_ic"] },
        "revision": { "type": "integer", "minimum": 0 },
        "project_hash": { "$ref": "#/$defs/hash" },
        "document_hash": { "$ref": "#/$defs/hash" },
        "connectivity_hash": { "$ref": "#/$defs/hash" },
        "module_hashes": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/hash" }
        },
        "module_count": { "type": "integer", "minimum": 1 },
        "module_instance_count": { "type": "integer", "minimum": 0 },
        "pdk_device_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "pdk": {
      "type": "object",
      "required": [
        "logical_id",
        "source_kind",
        "revision",
        "fingerprint",
        "license_hash",
        "lock_hash"
      ],
      "properties": {
        "logical_id": { "type": "string", "minLength": 1 },
        "source_kind": { "enum": ["open", "commercial"] },
        "revision": { "type": "string", "minLength": 1 },
        "fingerprint": { "$ref": "#/$defs/hash" },
        "license_hash": { "$ref": "#/$defs/hash" },
        "lock_hash": { "$ref": "#/$defs/hash" }
      },
      "additionalProperties": false
    },
    "tools": {
      "type": "object",
      "required": ["record_hash", "versions"],
      "properties": {
        "record_hash": { "$ref": "#/$defs/hash" },
        "versions": {
          "type": "object",
          "required": ["ngspice", "xyce", "openvaf", "xschem"],
          "properties": {
            "ngspice": { "type": "string", "minLength": 1 },
            "xyce": { "type": "string", "minLength": 1 },
            "openvaf": { "type": "string", "minLength": 1 },
            "xschem": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status", "diagnostics"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["passed", "failed", "blocked"] },
          "diagnostics": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "path", "sha256", "external"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/hash" },
          "external": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "commercial_boundary": {
      "type": "object",
      "required": [
        "attested",
        "pdk_content_copied",
        "pdk_content_packaged",
        "pdk_content_uploaded"
      ],
      "properties": {
        "attested": { "type": "boolean" },
        "pdk_content_copied": { "const": false },
        "pdk_content_packaged": { "const": false },
        "pdk_content_uploaded": { "const": false }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
