{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://actoviq.local/schemas/execution-profile.schema.json",
  "title": "Actoviq Tool Execution Profile",
  "type": "object",
  "required": ["schema", "id", "providerId", "target", "allowedRoots", "qualification"],
  "properties": {
    "schema": { "const": "actoviq.execution-profile.v1" },
    "id": { "type": "string", "minLength": 1 },
    "providerId": {
      "enum": [
        "ngspice",
        "xyce",
        "cadence_spectre",
        "synopsys_primesim_hspice",
        "synopsys_primesim_xa",
        "siemens_afs",
        "cadence_xcelium_ams",
        "synopsys_vcs_ams",
        "siemens_questa_ams"
      ]
    },
    "target": { "enum": ["local_linux", "local_windows", "ssh_linux"] },
    "executable": { "type": "string", "minLength": 1 },
    "allowedRoots": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "allowedEnvironmentKeys": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "ssh": {
      "type": "object",
      "required": ["host", "remoteWorkingDirectory"],
      "properties": {
        "host": { "type": "string", "pattern": "^[A-Za-z0-9_.@-]+$" },
        "executable": { "type": "string", "minLength": 1 },
        "remoteWorkingDirectory": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "qualification": { "enum": ["configured", "unverified", "native_verified"] }
  },
  "additionalProperties": false
}
